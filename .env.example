# Public site URL used for canonical links, the sitemap, and email links.
SITE=http://localhost:4321

# Local mail catcher. Mailpit listens here in development. Do not point this
# at a real inbox unless you mean to email the salon.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Style Empire <bookings@localhost>

# Found on a business-data index, not on the live Google profile. Confirm it
# before you send real mail.
MANAGER_EMAIL=style.empire@outlook.com

# demo: online payment confirms the booking and charges nothing.
# stripe: needs STRIPE_SECRET_KEY and a price on the service.
# leave unset in production until Stripe is ready. Unset means pay in the salon only.
PAYMENT_MODE=demo

# STRIPE_SECRET_KEY=sk_test_...
# BOOKINGS_DB=data/bookings.sqlite
